# ═══════════════════════════════════════════
# PURECODE CRM — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# ── GoHighLevel ──
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_BASE_URL=https://rest.gohighlevel.com/v1

# ── JustCall ──
JUSTCALL_API_KEY=your_justcall_api_key_here
JUSTCALL_API_SECRET=your_justcall_api_secret_here
JUSTCALL_BASE_URL=https://api.justcall.io/v1

# ── Auth ──
JWT_SECRET=generate_a_random_64_char_string_here
JWT_EXPIRES_IN=24h

# ── Server ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Production (fill when deploying) ──
# FRONTEND_URL=https://app.purecodeagency.com
