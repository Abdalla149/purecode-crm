# Copy this to .env and fill in real values for local dev.
# In Railway, set these in the Variables tab — no .env file needed.

# ── CRM API ──────────────────────────────────────────────
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxx
GHL_BASE_URL=https://services.leadconnectorhq.com

# ── Calling Service ──────────────────────────────────────
JUSTCALL_API_KEY=your_justcall_api_key
JUSTCALL_API_SECRET=your_justcall_api_secret
JUSTCALL_BASE_URL=https://api.justcall.io/v1
JUSTCALL_WEBHOOK_SECRET=      # optional — enables signature verification

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=generate_with: openssl rand -hex 32
JWT_EXPIRES_IN=24h

# ── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://app.purecodeagency.com
